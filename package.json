{
  "name": "mosaic",
  "version": "4.0.0-beta.7",
  "description": "MOSAIC 4.0 - Your Ultimate Mod Manager",
  "main": "out/main/main.js",
  "author": {
    "name": "Shattered Chaos",
    "email": "noreply@fightplanner.app"
  },
  "license": "MIT",
  "scripts": {
    "start": "npx nodemon --watch out --delay 1 --exec \"electron .\"",
    "ts:build": "tsc --build",
    "ts:watch": "tsc --build --watch",
    "dev:reload": "concurrently \"npm run ts:watch\" \"npm run start\"",
    "build:test": "npm run ts:build && electron-builder --win portable --config",
    "build:win": "npm run ts:build && electron-builder --win --config",
    "build:linux": "npm run ts:build && electron-builder --linux --config",
    "build:appimage": "npm run ts:build && electron-builder --linux AppImage --config",
    "build:rpm": "npm run ts:build && electron-builder --linux rpm --config",
    "build:all": "npm run ts:build && electron-builder -wml --config",
    "dist": "npm run ts:build && electron-builder",
    "i18n:upload": "crowdin upload sources",
    "i18n:download": "crowdin download",
    "i18n:status": "crowdin status",
    "i18n:sync": "npm run i18n:upload && npm run i18n:download"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "basic-ftp": "^5.3.1",
    "discord-rpc": "^4.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "fast-xml-parser": "^5.7.0",
    "gsap": "3.12.5",
    "lottie-web": "5.12.2",
    "node-7z": "^3.0.0",
    "posthog-node": "^5.21.2"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node-7z": "^2.1.11",
    "concurrently": "^10.0.4",
    "electron": "^41.1.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.8.0",
    "semver": "^7.6.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "build": {
    "appId": "com.shatteredchaos.mosaic",
    "productName": "MOSAIC",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "FIREXDF",
        "repo": "MOSAIC",
        "channel": "latest"
      }
    ],
    "extraResources": [
      {
        "from": "tools/prc2json",
        "to": "tools/prc2json",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "tools/MSBTEditorCLI",
        "to": "tools/MSBTEditorCLI",
        "filter": [
          "MSBTEditorCli.dll"
        ]
      }
    ],
    "protocols": [
      {
        "name": "MOSAIC Protocol",
        "role": "Viewer",
        "schemes": [
          "fightplanner",
          "mosaic"
        ]
      }
    ],
    "files": [
      "out/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets/app-icons",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icons/icon.ico",
      "verifyUpdateCodeSignature": false,
      "extraResources": [
        {
          "from": "tools/7z/win",
          "to": "tools/7z/win",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "tools/ParamXML/windows",
          "to": "tools/ParamXML/windows",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "tools/MSBTEditorCLI/win-x64",
          "to": "tools/MSBTEditorCLI/win-x64",
          "filter": [
            "**/*",
            "!publish{,/**/*}"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MOSAIC",
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icons/icon.icon",
      "category": "public.app-category.utilities",
      "extraResources": [
        {
          "from": "tools/7z/macos",
          "to": "tools/7z/macos",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "tools/ParamXML/osx-${arch}",
          "to": "tools/ParamXML/osx-${arch}",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "tools/MSBTEditorCLI/osx-${arch}",
          "to": "tools/MSBTEditorCLI/osx-${arch}",
          "filter": [
            "**/*",
            "!publish{,/**/*}"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "assets/app-icons/icon.png",
      "category": "Utility",
      "maintainer": "Shattered Chaos <noreply@fightplanner.app>",
      "extraResources": [
        {
          "from": "tools/7z/linux",
          "to": "tools/7z/linux",
          "filter": [
            "7zzs"
          ]
        },
        {
          "from": "tools/ParamXML/linux",
          "to": "tools/ParamXML/linux",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "tools/MSBTEditorCLI/linux-x64",
          "to": "tools/MSBTEditorCLI/linux-x64",
          "filter": [
            "**/*",
            "!publish{,/**/*}"
          ]
        }
      ]
    }
  }
}
